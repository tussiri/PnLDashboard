map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    # nginx resolves a literal upstream hostname ONCE at startup. Recreating the api container gives
    # it a new address, and this server kept proxying to the old one until it was restarted itself -
    # every /api call answered 502, the front end read that as "API unreachable" and quietly served
    # the demo dataset, so a redeploy left a dashboard full of synthetic figures that still looked
    # like a working dashboard. Resolving through a variable defers the lookup to request time and
    # honours the record's TTL, so the proxy follows the container across restarts.
    # A proxy_pass whose value contains a variable carries NO URI part: nginx then forwards the
    # request URI unchanged instead of substituting the location prefix. That is what is wanted here
    # (this location and the API both live under /api/), but writing "$api_upstream/api/" would send
    # the literal path /api/ for every request and answer 404 on all of them.
    # API_UPSTREAM and NGINX_RESOLVER are filled in at container start (templates/, 15-resolver.envsh):
    # api:8000 and Docker's DNS locally; the private API service and the platform nameserver on Render.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Behind Render's TLS edge this server sees plain HTTP; keep the edge's scheme so the API marks
    # the session cookie Secure.
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 5s;
    # Admin-triggered syncs and mart rebuilds are synchronous; a tenant backfill can take minutes.
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
    expires 7d;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
}

