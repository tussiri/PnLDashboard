# Copy to .env. Replace every value marked CHANGE_ME before exposing the stack.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_local_postgres_only
APP_DB_NAME=facilities
APP_DB_USER=facilities_app
APP_DB_PASSWORD=CHANGE_ME_app_database
ANALYTICS_DB_USER=facilities_analytics
ANALYTICS_DB_PASSWORD=CHANGE_ME_analytics_read_only
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase_app
METABASE_DB_PASSWORD=CHANGE_ME_metabase_application
METABASE_IMAGE=metabase/metabase:v0.63.13
METABASE_SITE_NAME=Crane IFS Analytics

# Server-side WinTeam / TEAM Concourse ("wtnextgen") settings. Never prefix these with VITE_.
# See config/winteam-endpoints.md for what each documented endpoint needs.
WINTEAM_ENABLED=false
# Gateway base, e.g. https://api.myteamsoftware.com/wtnextgen (no trailing slash, HTTPS).
WINTEAM_BASE_URL=
# Required on every call: the tenantId GUID issued by TEAM.
WINTEAM_TENANT_ID=
# Azure API Management subscription key (sent only when set) and the header it travels in.
WINTEAM_SUBSCRIPTION_KEY=
WINTEAM_SUBSCRIPTION_KEY_HEADER=Ocp-Apim-Subscription-Key
# Extra headers as a JSON object, merged into every request (rarely needed).
WINTEAM_HEADERS_JSON={}
# Syncs run nightly, every WINTEAM_SYNC_INTERVAL_MINUTES (timekeeping only) and on demand (Admin view, or
# POST /api/v1/integrations/winteam/sync).
# Comma separated subset of: jobs,vendors,timekeeping,job_schedules,gl_budgets,job_budgets,ap_invoices,
# ap_invoice_details,ar_invoices,ap_payments. gl_budgets is off: this tenant returns no GL budgets.
WINTEAM_RESOURCES=jobs,vendors,timekeeping,job_schedules,job_budgets,ap_invoices,ap_invoice_details,ar_invoices,ap_payments
# Receivables require a customerNumber per call: list the customers to pull (comma separated).
WINTEAM_CUSTOMER_NUMBERS=
# Optional: only pull jobs for these locationId values (comma separated integers).
WINTEAM_LOCATION_IDS=
WINTEAM_PAGE_SIZE=100
# First sync of date-windowed resources starts this many months back; later syncs re-pull
# WINTEAM_LOOKBACK_DAYS before the last sync (WINTEAM_DEEP_LOOKBACK_DAYS with deep=true, to catch
# later edits). Pulls are chunked into WINTEAM_WINDOW_DAYS windows. Jobs, vendors, budgets and AR
# are re-read at most once per 20 hours unless force=true.
WINTEAM_BACKFILL_MONTHS=18
WINTEAM_WINDOW_DAYS=16
WINTEAM_LOOKBACK_DAYS=3
WINTEAM_DEEP_LOOKBACK_DAYS=35
# GL budgets are requested for the current and previous calendar years by default.
WINTEAM_GL_FISCAL_YEARS=2
# 0 = pull schedules for every active job; set a small number while validating a tenant.
WINTEAM_SCHEDULE_JOBS_LIMIT=0
WINTEAM_REQUEST_TIMEOUT_SECONDS=30
# Guard against runaway pagination of a single listing.
WINTEAM_MAX_PAGES_PER_SYNC=500
WINTEAM_MAX_RETRIES=4
WINTEAM_ALLOW_INSECURE_HTTP=false
# Gateway API prefix appended when WINTEAM_BASE_URL omits it (verified: /wtnextgen).
WINTEAM_API_PREFIX=/wtnextgen
# Promote landed API records into core tables after each pull (false = raw landing only).
WINTEAM_NORMALIZE=true
# 0 = request GL budgets for every active job; set small while validating.
WINTEAM_GL_JOBS_LIMIT=0

# Second data source: the real WinTeam report exports restored from the Finance_Dashboard dump into a
# read-only database (locally: `finance_reference` in the same Postgres container, readable by the app
# role). Empty = not configured; the Administration page then shows the source as unavailable.
# Loading it (POST /api/v1/integrations/finance-reference/load) replaces everything another source put in
# the warehouse. See docs/finance-reference-source.md.
FINANCE_REFERENCE_DATABASE_URL=postgresql://facilities_app:CHANGE_ME_app_database@postgres:5432/finance_reference
# Optional directory holding Crane_job_master_report.csv and city_centroids.json (default: the copies
# packaged with the API under services/api/app/sources/data).
FINANCE_REFERENCE_DATA_DIR=

# Protect manual sync/test endpoints. Worker execution does not expose this value.
INGESTION_ADMIN_TOKEN=CHANGE_ME_admin_token
LOG_LEVEL=INFO

# Sign-in and roles (docs/auth-rbac.md). Production: APP_AUTH_MODE=required and a long random
# APP_SESSION_SECRET (e.g. `openssl rand -hex 32`). Users are managed in Admin > Users; the first
# administrator is created on the sign-in page with APP_SETUP_TOKEN (e.g. `openssl rand -hex 24`).
# APP_USERS_JSON optionally adds environment users with a PBKDF2 hash from
# `docker compose run --rm api python -m app.auth hash '<password>'`.
# Roles: executive (Executive Overview only), analyst (everything except Administration), admin (all).
# Keep the JSON single-quoted: the hashes contain "$", which Compose would otherwise try to expand.
# APP_AUTH_MODE=dev enables the fixed development users executive / analyst / admin (password dev-<username>).
APP_AUTH_MODE=required
APP_SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_characters
APP_SETUP_TOKEN=CHANGE_ME_setup_code_at_least_24_characters
APP_USERS_JSON='[]'

# Browser talks only to this same-origin API path through nginx.
VITE_API_BASE_URL=/api/v1

# ── CompanyCam site photos (optional) ────────────────────────────────────────
# Server-side only: the browser never sees this token and never calls CompanyCam
# directly, it asks /api/v1/integrations/companycam/*. Never use a VITE_ prefix.
# Leave blank and photos stay off - the map says so rather than erroring.
COMPANYCAM_API_TOKEN=
# How a CompanyCam project maps to a WinTeam job. Leave blank until the production
# data has been probed with GET /api/v1/integrations/companycam/probe (admin), then
# set one of: job_number_in_name | address | project_map
COMPANYCAM_MATCH_RULE=

# ── Sarus WinTeam database (second tenant, optional) ─────────────────────────
# Test before enabling: POST /api/v1/integrations/winteam/sarus/test (admin). Enabled = the worker
# syncs it nightly and on the timekeeping interval, and the Admin view's "Sync Sarus" may run.
WINTEAM_SARUS_ENABLED=false
# Blank = same gateway as WINTEAM_BASE_URL.
WINTEAM_SARUS_BASE_URL=
WINTEAM_SARUS_TENANT_ID=
# Same value as WINTEAM_SUBSCRIPTION_KEY if Sarus is on the same APIM subscription.
WINTEAM_SARUS_SUBSCRIPTION_KEY=
WINTEAM_SARUS_HEADERS_JSON={}

# Relay (integration_mapper) read-only export for FedEx: AP, AR, sites, work orders (app/relay.py).
# Base URL of the Relay service; the token is one of Relay's DASHBOARD_EXPORT_TOKENS. Blank = off.
RELAY_BASE_URL=
RELAY_EXPORT_TOKEN=
RELAY_TIMEOUT_SECONDS=60

# Worker schedules, in minutes (0 = off). Every WINTEAM_SYNC_INTERVAL_MINUTES the worker syncs WinTeam
# timekeeping (3-day lookback; jobs at most once per 20 hours) for the primary database and Sarus, then
# rebuilds the marts; the nightly sync and the Admin buttons are unaffected. PV_SYNC_INTERVAL_MINUTES
# paces the PhotoValidation pull below.
WINTEAM_SYNC_INTERVAL_MINUTES=30
PV_SYNC_INTERVAL_MINUTES=15

# PhotoValidation staffing requests (app/sources/photovalidation.py): the PhotoValidation origin and one
# of its API tokens (crane_sk_...). Blank = off.
PHOTOVALIDATION_API_URL=
PHOTOVALIDATION_API_TOKEN=
# Reports mailbox poller (docs/mail-inbox.md). Microsoft Graph app registration, application permission
# Mail.Read, limited to the mailbox with an Exchange application access policy. Empty = not configured.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=reports@smcraneifs.com
# Claude API key for the FedEx feedback comment summary (docs/api-contract.md). Server-side only.
# Blank = the Home feedback tile shows scores without the comment summary.
ANTHROPIC_API_KEY=
FEEDBACK_SUMMARY_MODEL=claude-opus-5-5
